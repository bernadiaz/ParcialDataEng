# Ambiente examen / cloud (AWS S3 real + Snowflake + dbt)
# Uso: ENV=prod make all MES=2025-03
# Secretos (keys, passwords) van en .env — nunca en este archivo.
APP_ENV=prod

# AWS S3 real (sin endpoint local)
S3_ENDPOINT_URL=
S3_BUCKET=nyc-taxi-exam
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PATH_STYLE=false
S3_RAW_PREFIX=raw
S3_CONTROL_PREFIX=control

SKIP_SNOWFLAKE=0
SKIP_DBT=0

# DuckDB (sigue validando calidad local antes de cargar)
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=2GB
DATA_DIR=/app/data

MAX_DISTANCE_MILES=100
CBD_FEE_MISSING_STRATEGY=null
INGEST_MAX_RETRIES=3

AIRBYTE_ENABLED=true

# Snowflake (valores no secretos; password/key en .env)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=TAXI_ROLE
SNOWFLAKE_WAREHOUSE=WH_TAXI_RUN
SNOWFLAKE_DATABASE=NYC_TAXI
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_STAGING=STAGING
SNOWFLAKE_SCHEMA_MARTS=MARTS
