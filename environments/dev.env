# Ambiente local / notebook 8 GB RAM
# Uso: ENV=dev make all MES=2025-03
APP_ENV=dev

# S3 compatible local (MinIO en Docker)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=nyc-taxi
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PATH_STYLE=true

# Paths lógicos (estilo Hive)
S3_RAW_PREFIX=raw
S3_CONTROL_PREFIX=control

# fs = data/object_store (sin MinIO; ideal 8 GB). s3 = MinIO/AWS.
OBJECT_STORE=fs

# Warehouse: en dev el pipeline puede trabajar 100% local (DuckDB)
# y dejar Snowflake opcional (SKIP_SNOWFLAKE=1)
SKIP_SNOWFLAKE=1
SKIP_DBT=1

# DuckDB
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=2GB
# DATA_DIR: en Docker el compose exporta /app/data; en host usa ./data del repo

# Pipeline
MAX_DISTANCE_MILES=100
CBD_FEE_MISSING_STRATEGY=null
INGEST_MAX_RETRIES=3

# Airbyte (opcional en dev; la ingesta ligera escribe a los mismos paths)
AIRBYTE_ENABLED=false

# Monitoreo (make up-monitoring). Pushgateway en el host.
METRICS_ENABLED=1
PUSHGATEWAY_URL=http://localhost:9091

# Monitoreo (make up-monitoring)
METRICS_ENABLED=true
PUSHGATEWAY_URL=http://localhost:9091
