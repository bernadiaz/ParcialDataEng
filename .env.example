# Copiar a .env y completar. Nunca commitear .env.
ENV=dev

# AWS (prod) o sobrescribe MinIO (dev)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Snowflake (prod)
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=

# Airbyte API (si AIRBYTE_ENABLED=true)
# AIRBYTE_API_URL=http://localhost:8000/api/v1
# AIRBYTE_CLIENT_ID=
# AIRBYTE_CLIENT_SECRET=
# AIRBYTE_CONNECTION_ID_YELLOW=
# AIRBYTE_CONNECTION_ID_ZONES=
