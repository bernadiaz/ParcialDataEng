# =====================================================================================
# NYC Taxi pipeline - settings and credentials template.
# Copy to .env (gitignored) and fill it in. The Makefile, src/config.py and docker compose read .env.
# Portable on Windows, Linux and macOS:
#   - "~" means your home folder (C:\Users\<you>, /home/<you>, /Users/<you>)
#   - relative paths are relative to the repository root
# Do not write comments at the end of a value line: make would keep them as part of the value.
# =====================================================================================

# --- Run options ----------------------------------------------------------------------
# Warehouse: snowflake (plan default) or duckdb (offline validation, no cloud needed)
WAREHOUSE=snowflake
# Ingestion: hybrid (Airbyte for the zone lookup, monthly Parquet files streamed unmodified to S3:
# Airbyte's File source cannot serialize the Parquet timestamps, see airbyte/README_AIRBYTE.md),
# airbyte (everything through Airbyte) or direct (no Airbyte at all)
INGEST_MODE=hybrid
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
# Local data: raw mirror, curated, quarantine, reports, logs, control DB, DuckDB warehouse and
# Dagster run history (DATA_DIR/dagster_home). Empty = ./data inside the repo. Keep it outside
# folders synced by OneDrive/Dropbox/iCloud: sync clients lock DuckDB files.
DATA_DIR=~/nyc_taxi_data

# --- AWS ------------------------------------------------------------------------------
# Profile created with the AWS Toolkit or `aws configure --profile nyc-taxi` (keys stay in ~/.aws)
AWS_ACCOUNT_ID=
AWS_PROFILE=nyc-taxi
AWS_REGION=us-east-1
S3_BUCKET=
S3_RAW_PREFIX=raw

# --- Airbyte (abctl local install) ----------------------------------------------------
# abctl publishes Airbyte on http://localhost:8000 by default (8001 if you passed --port 8001)
AIRBYTE_API_URL=http://localhost:8000/api/public/v1
# Get them with: abctl local credentials (workspace id: the UUID in the Airbyte UI URL)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=
# The Airbyte S3 destination cannot read AWS profiles: access keys of the IAM user nyc-taxi-pipeline
AIRBYTE_S3_ACCESS_KEY_ID=
AIRBYTE_S3_SECRET_ACCESS_KEY=

# --- Snowflake --------------------------------------------------------------------------
# Account identifier ORG-ACCOUNT (Snowsight > Account details)
SNOWFLAKE_ACCOUNT=
# Service user with a key pair (snowflake/setup.sql step 7). Recommended for every step.
SNOWFLAKE_USER=TAXI_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/taxi_svc.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Only used when SNOWFLAKE_PRIVATE_KEY_PATH is empty. externalbrowser needs a SAML identity provider.
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# Objects created by snowflake/setup.sql
SNOWFLAKE_ROLE=TAXI_PIPELINE
SNOWFLAKE_WAREHOUSE=WH_TAXI_DEV
SNOWFLAKE_DATABASE=NYC_TAXI

# --- FinOps cost tags (query_tag on every query) ----------------------------------------
COST_ENV=dev
COST_OWNER=

# --- Observability (docker compose: Prometheus, Pushgateway, Grafana, Loki, Alloy, Dozzle) ---
PUSHGATEWAY_URL=http://localhost:9091
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Superset (http://localhost:8090) ---
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=
SUPERSET_URL=http://localhost:8090
# Superset runs in Docker (no browser SSO): it connects with the service user's key pair.
# Folder that holds the key (mounted read only in the container) and the key file name.
SNOWFLAKE_KEYS_DIR=~/.snowflake
SUPERSET_SNOWFLAKE_USER=TAXI_SVC
SUPERSET_SNOWFLAKE_KEY_FILE=taxi_svc.p8
SUPERSET_SNOWFLAKE_WAREHOUSE=WH_TAXI_DEV

# --- Dagster (make dagster-ui -> http://localhost:3003) ---
# Run history lives in DATA_DIR/dagster_home. Set DAGSTER_HOME only to keep it somewhere else.
